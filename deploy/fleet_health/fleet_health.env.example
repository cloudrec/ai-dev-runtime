# Required by owner-os-fleet-health.service, loaded from /root/ai-dev-runtime/configs/.env
# (already gitignored — never commit real values). This monitor reuses the SAME
# Telegram bot/chat Owner OS already uses for owner_push; it does not need its own.
#
# If these two are already set in configs/.env for owner-os-wake-companion.service,
# nothing further is needed here — this file exists only to document what the
# monitor requires and to bootstrap a fresh host that has neither set yet.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional tuning (defaults shown; uncomment to override)
# FLEET_HEALTH_FAIL_THRESHOLD=3
# FLEET_HEALTH_RECOVERY_THRESHOLD=2
# FLEET_HEALTH_REMINDER_INTERVAL_SECS=21600
