 MAX_WAKE_AGE_SECS = int(os.getenv("WAKE_BRIDGE_MAX_AGE_SECS", "10800"))
+
+# ── agents that must never mint an actionable wake ──────────────────────────
+# A wake is what CAUSES an automated write: the companion delivers it into a ChatGPT
+# conversation, and that conversation calls back through /agents/send and /agents/answer.
+# Suppressing the wake removes the cause, which is the only lever available here — the API
+# cannot tell an automated continuation from the owner's own command, because both arrive
+# as `api:bearer` from one address over one credential, and the sole distinguishing field
+# is a header the caller sets about itself.
+#
+# UNION, never replacement. `AUTO_REGISTER_DENY_PROJECTS` reads its list with
+# `os.getenv(NAME, default)`, which lets an environment file silently DROP an entry the
+# code added — that is how `diamond` left the live denylist while the commit adding it sat
+# in the tree looking effective. Env may add here; it cannot remove.
+_SUPPRESS_RAW = os.getenv("WAKE_BRIDGE_SUPPRESS_AGENTS", "")
+WAKE_SUPPRESSED_AGENTS = {"payorch-ha-fresh:0.0"} | {
+    a.strip() for a in _SUPPRESS_RAW.split(",") if a.strip()}
+
+
+def _suppressed_conversation_ids(conn=None) -> set:
+    """The runtime session ids of the suppressed agents.
+
+    Events from one pane arrive under TWO identities: the tmux target
+    (`payorch-ha-fresh:0.0`, 398 events in a week) and a session ref
+    (`session:6db4919a-460`, 1031 events). A rule matching only the target string would
+    miss the larger half, so the identity sidecar is used to bridge them.
+
+    `source='runtime'` is required. The cwd fallback hands several panes in one directory
+    the SAME session id — `hostsecure-clean:0.0` demonstrably carries another pane's — so a
+    guessed id would silence a different agent's alerts entirely. Suppression is
+    fail-closed for automation and fail-OPEN for the owner's visibility, so it must never
+    rest on a guess.
+    """
+    if not WAKE_SUPPRESSED_AGENTS:
+        return set()
+    own = False
+    try:
+        # `_conn` runs the schema statements, so it raises on an unreadable store too —
+        # the first draft caught only the SELECT and let that escape into should_wake,
+        # which would have taken the whole wake bridge down with the sidecar.
+        conn, own = _conn(conn)
+        rows = conn.execute(
+            "SELECT conversation_id FROM agent_identity_source "
+            "WHERE source='runtime' AND conversation_id != '' AND target IN (%s)"
+            % ",".join("?" * len(WAKE_SUPPRESSED_AGENTS)),
+            tuple(sorted(WAKE_SUPPRESSED_AGENTS))).fetchall()
+        return {r[0] for r in rows if r[0]}
+    except sqlite3.Error:
+        # No sidecar yet, or unreadable. The target-string half of the rule still applies;
+        # this only narrows what the session-ref half can match.
+        return set()
+    finally:
+        if own:
+            try:
+                conn.close()
+            except sqlite3.Error:
+                pass
+
+
+def agent_wake_suppressed(agent_id: str = "", conn=None) -> bool:
+    """True when this event's agent may not produce a wake, under EITHER identity."""
+    ref = (agent_id or "").strip()
+    if not ref or not WAKE_SUPPRESSED_AGENTS:
+        return False
+    if ref in WAKE_SUPPRESSED_AGENTS:
+        return True
+    if ref.startswith("session:"):
+        sid = ref[len("session:"):]
+        if not sid:
+            return False
+        # The ref is truncated by `_sanitize_agent_ref`, so the stored id is matched by
+        # prefix — and only in that direction, so a short or empty ref cannot match
+        # everything.
+        return any(full.startswith(sid) for full in _suppressed_conversation_ids(conn))
+    return False
 # Only these severities are ever worth a wake.
 WAKE_SEVERITIES = {"critical", "high"}
 
@@ -665,6 +740,12 @@ def should_wake(*, event_id: int, severity: str, correlation_id: str = "",
         return {"wake": False, "reason": "kill_switch_engaged"}
     if not enabled:
