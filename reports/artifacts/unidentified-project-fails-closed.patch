index 0000000..e334a34
--- /dev/null
+++ b/tests/test_unidentified_project_fails_closed.py
@@ -0,0 +1,123 @@
+"""An identity this system cannot establish is not an identity that passed a check.
+
+Three live shapes resolve to no project at all, and every one of them was `allowed`,
+because a name that matches nothing matches no denylist entry either:
+
+    /opt                                     a workspace root, 370 events, 2 live agents
+    /tmp/claude-0/<enc>/<session>/scratchpad  a scratchpad, 8 events
+    /root/.claude/projects/-opt-x/memory      `.claude` fails normalize_key -> ""
+
+`/opt` is the worst of the three: it is the parent of payment-orchestrator, diamond,
+capacity and email — four of the eight deny-listed projects — so an agent that simply
+cd's up one level is denied by none of them. Session 01bb4e35 demonstrates the general
+case, having been filed under thirteen project ids in a week while belonging to
+`gaika-extension-ru` the whole time.
+
+These tests pin the fail-closed rule and, with equal weight, pin that it did not widen
+anything: every allowed path stays allowed and the denylist itself is untouched.
+"""
+from __future__ import annotations
+
+import pytest
+
+from core import native_supervisor as ns
+from core import wake_routes as wr
+
+SCRATCH = "/tmp/claude-0/-opt-gaika-extension-ru/01bb4e35-2097-44eb-94df-df5b48f2de7b/scratchpad"
+MEMORY = "/root/.claude/projects/-opt-gaika-extension/memory"
+
+
+# ── no project is derivable ─────────────────────────────────────────────────
+@pytest.mark.parametrize("cwd", ["/opt", "/opt/", "/root", "/srv", SCRATCH, MEMORY, "", "/"])
+def test_these_paths_name_no_project(cwd):
+    assert wr.project_for_cwd(cwd) == ""
+
+
+def test_a_workspace_root_no_longer_invents_a_project_called_opt():
+    """The exact live shape: cwd '/opt', filed as project 'opt', denied by nothing."""
+    assert wr.project_for_cwd("/opt") == ""
+    assert ns._project_of({"claude_cwd": "/opt"}) == ""
+
+
+# ── and therefore denies ────────────────────────────────────────────────────
+@pytest.mark.parametrize("cwd", ["/opt", "/root", "/srv", SCRATCH, MEMORY])
+def test_an_unidentified_agent_is_denied(cwd):
+    assert ns._identity_unknown("", cwd) is True
+    assert ns._denied_for("", cwd) is True
+
+
+def test_the_two_live_opt_agents_would_stop_being_auto_registered():
+    """Names the cost explicitly so it is a decision, not a surprise."""
+    agents = [{"target": "main105-backup-repair:0.0", "claude_cwd": "/opt"},
+              {"target": "session-f2c240aa:0.0", "claude_cwd": "/opt"}]
+    for a in agents:
+        assert ns._denied_for(ns._project_of(a), a["claude_cwd"]) is True
+
+
+def test_the_block_reason_says_unidentified_not_unregistered():
+    """`not_registered` would tell the owner that registering it is the remedy."""
+    assert ns.send_block_reason("x:0.0", "", cwd="/opt") == "project_identity_unknown"
+    assert ns.send_block_reason("x:0.0", "", cwd=SCRATCH) == "project_identity_unknown"
+
+
+# ── the denial boundary did not move ────────────────────────────────────────
+def test_every_deny_listed_project_is_still_denied_at_its_own_root():
+    for proj in sorted(ns.AUTO_REGISTER_DENY_PROJECTS):
+        cwd = f"/opt/{proj}"
+        assert ns._denied_for(wr.project_for_cwd(cwd), cwd) is True, proj
+
+
+def test_denied_projects_stay_denied_in_their_subdirectories():
+    for cwd in ("/opt/payment-orchestrator/deploy/infra/dns",
+                "/opt/diamond/auction",
+                "/opt/capacity/src/app"):
+        assert ns._denied_for(wr.project_for_cwd(cwd), cwd) is True, cwd
+
+
+@pytest.mark.parametrize("cwd,proj", [
+    ("/opt/hostsecure/src", "hostsecure"),
+    ("/opt/gaika-worktrees/ru", "gaika-worktrees"),
+    ("/opt/mess/app", "mess"),
+    ("/opt/security-demo", "security-demo"),
+])
+def test_an_allowed_project_is_still_allowed(cwd, proj):
+    """The half that proves this is a tightening and not a shutdown."""
+    assert wr.project_for_cwd(cwd) == proj
+    assert ns._identity_unknown(proj, cwd) is False
+    assert ns._denied_for(proj, cwd) is False
+
+
+def test_the_denylist_itself_is_unchanged():
+    """SELF_PROJECT is derived from the module's own location, so it is spelled
+    differently in a checkout under another name — which is exactly what caught this
+    assertion when it was first written against a copy. Everything else is fixed."""
+    assert ns.AUTO_REGISTER_DENY_PROJECTS - {ns.SELF_PROJECT} == {
+        "auction", "capacity", "diamond", "email",
+        "payment-orchestrator", "payorch", "xmrig"}
+    assert ns.SELF_PROJECT in ns.AUTO_REGISTER_DENY_PROJECTS
+
+
+def test_a_resolved_project_is_never_treated_as_unknown():
+    """The failure that would turn this into a global shutdown: reading any falsy
+    intermediate as 'no identity' and denying the whole host."""
+    allowed = 0
+    for cwd in ("/opt/a", "/opt/b/c", "/root/ai-dev-runtime/core", "/srv/thing/x"):
+        proj = wr.project_for_cwd(cwd)
+        assert proj, cwd
+        if not ns._denied_for(proj, cwd):
+            allowed += 1
+    assert allowed >= 3, "the rule denied paths that name a perfectly good project"
+
+
+def test_an_explicit_project_survives_an_unresolvable_cwd():
+    """A stored row may carry a project whose cwd has since gone. The name is evidence;
+    losing the directory must not retroactively unidentify it."""
+    assert ns._identity_unknown("hostsecure", "") is False
+    assert ns._denied_for("hostsecure", "") is False
+    assert ns._denied_for("payorch", "") is True
+
+
+def test_the_self_reference_reason_still_wins_over_the_new_one():
+    assert ns.send_block_reason("x:0.0", ns.SELF_PROJECT,
+                                cwd=f"/root/{ns.SELF_PROJECT}/core") == \
+        "supervisor_self_reference"
