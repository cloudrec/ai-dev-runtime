@@ -0,0 +1,82 @@
+"""A scratchpad directory carries no project identity.
+
+Events 51561 and 51565 (`agent_process_failed`, critical) were filed under a project
+literally called `scratchpad`:
+
+    cwd = /tmp/claude-0/-opt-gaika-extension-ru/<session>/scratchpad
+
+`project_for_cwd` resolves configured roots, then the first segment under /opt, /root,
+/srv, then falls back to the basename. A scratchpad lives under /tmp, so it reached the
+fallback and the temp directory's own name became the project. Eight events landed there.
+
+Decoding the encoded name is NOT the fix, and both reasons are pinned below: it names
+where the session STARTED rather than where the agent is (that agent actually works in
+/opt/gaika-worktrees/ru, and neither reading of the encoded string exists on disk), and
+the encoding is lossy because "/" becomes "-" while "-" is legal in names — 43 of the 90
+directories under /opt on this host contain one.
+"""
+from __future__ import annotations
+
+import pytest
+
+from core import wake_routes as wr
+
+SCRATCH = "/tmp/claude-0/-opt-gaika-extension-ru/01bb4e35-2097-44eb-94df-df5b48f2de7b/scratchpad"
+
+
+def test_the_live_event_path_yields_no_project():
+    assert wr.project_for_cwd(SCRATCH) == "", \
+        "events 51561/51565 were filed under a project called 'scratchpad'"
+
+
+def test_a_directory_inside_the_scratchpad_is_also_not_a_project():
+    assert wr.project_for_cwd(SCRATCH + "/notes/deep") == ""
+
+
+def test_it_is_recognised_as_a_scratchpad():
+    assert wr.is_scratchpad_path(SCRATCH) is True
+    assert wr.is_scratchpad_path(SCRATCH + "/") is True
+    assert wr.is_scratchpad_path("/opt/payment-orchestrator") is False
+
+
+def test_the_encoded_name_is_never_decoded():
+    """Both readings of the encoded name are wrong, and one of them is deny-listed-
+    adjacent. Returning either would be worse than returning nothing."""
+    got = wr.project_for_cwd(SCRATCH)
+    assert got not in ("gaika-extension-ru", "gaika", "extension-ru", "opt")
+    assert got == ""
+
+
+def test_a_scratchpad_for_a_payment_session_is_not_an_escape_hatch():
+    """The reason this matters beyond tidiness: every agent has a scratchpad, so a
+    payment agent whose hook fires from one must not acquire a fresh, undenied project."""
+    from core import native_supervisor as ns
+    cwd = "/tmp/claude-0/-opt-payment-orchestrator/abc/scratchpad"
+    assert wr.project_for_cwd(cwd) == ""
+    # unknown project + the path's own segments: denial must still see payment
+    assert "payment-orchestrator" in ns.project_candidates("", cwd) or \
+        ns._denied_for("", cwd), "a scratchpad must not walk an agent out of the denylist"
+
+
+# ── real project paths are untouched ────────────────────────────────────────
+@pytest.mark.parametrize("cwd,expected", [
+    ("/opt/payment-orchestrator/deploy/infra/dns", "payment-orchestrator"),
+    ("/opt/gaika-worktrees/ru", "gaika-worktrees"),
+    ("/root/ai-dev-runtime/core", "ai-dev-runtime"),
+    ("/tmp/other/thing", "thing"),          # an ordinary /tmp path keeps the old answer
+])
+def test_everything_that_is_not_a_scratchpad_is_unchanged(cwd, expected):
+    assert wr.project_for_cwd(cwd) == expected
+
+
+def test_only_the_claude_scratchpad_shape_matches():
+    """Narrow by construction — a project that merely ends in 'scratchpad' is a project."""
+    assert wr.project_for_cwd("/opt/scratchpad") == "scratchpad"
+    assert wr.is_scratchpad_path("/opt/myproj/scratchpad") is False
+    assert wr.is_scratchpad_path("/tmp/claude-0/x/scratchpad") is True
+
+
+def test_unknown_is_returned_not_invented():
+    """Fail closed: no project beats a plausible wrong one, because routing has a
+    fallback and the denylist reads the value."""
+    assert wr.project_for_cwd("/tmp/claude-9/-opt-anything/sess/scratchpad") == ""
