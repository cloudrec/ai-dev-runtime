+            if str(h.get("target") or "").split(":", 1)[0] != session:
+                continue
+            if redispatch:
+                return True
+            c = tc.get(cid, conn=conn)
+            if not c or c["state"] == tc.WORKING:
+                return True
+        return False
+    except Exception:  # noqa: BLE001 — unreadable state: defer the rotation
+        return True
+    finally:
+        if own:
+            conn.close()
