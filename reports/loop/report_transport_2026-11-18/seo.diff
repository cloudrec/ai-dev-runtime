+def _report_read_payload(result):
+    """Carry a read report's text under `text`, never under a top-level `content`.
+
+    The runtime answers a read with {project_dir, path, truncated, content: <str>}. In an
+    MCP tool result `content` is the protocol's item list; a payload whose top-level
+    `content` is a string was the only one of its kind, and ChatGPT showed it as `{}` while
+    the listing (no such key) worked. The text itself is unchanged (already bounded and
+    redacted by the runtime); refusals and errors pass through untouched.
+    """
+    if not isinstance(result, dict) or "error" in result or "content" not in result:
+        return result
+    out = {k: v for k, v in result.items() if k != "content"}
+    text = result["content"]
+    out["text"] = text
+    if isinstance(text, str):
+        out["chars"] = len(text)
+    return out
 
 
