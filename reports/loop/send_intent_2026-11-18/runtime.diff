+_SEND_EVIDENCE_JS = """(function(m, us, asl, cs){
+  const users=[...document.querySelectorAll(us)];
+  let mine=null;
+  for (const e of users) { if ((e.textContent||'').includes(m)) mine=e; }
+  let answered=false;
+  if (mine) {
+    for (const a of document.querySelectorAll(asl)) {
