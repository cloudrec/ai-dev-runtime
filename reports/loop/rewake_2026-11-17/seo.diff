+"""Keep secrets that travel in URLs out of the access log.
+
+Three routes carry a credential in the PATH: the ChatGPT MCP connector
+(`/api/mcp/c/<token>`), the owner's release link (`/api/owner/fc-release/<token>`) and
+the owner's project page (`/api/owner/fc-page/<key>/...`). uvicorn writes every request
+line to `uvicorn.access` (gunicorn's UvicornWorker routes it to stdout), so `docker logs`
+held the live connector token. A filter on the access loggers rewrites the request line
+before any handler sees it; query values with a secret-looking name are blanked too.
+"""
+from __future__ import annotations
+
+import logging
+import re
+
+REDACTED = "<redacted>"
+_SECRET_PATH = re.compile(
+    r"(/api/mcp/c/|/api/owner/fc-release/|/api/owner/fc-page/)[^/?#\s\"']+")
+_SECRET_QUERY = re.compile(
+    r"([?&](?:token|access_token|key|secret|password|ptok|api_key)=)[^&#\s\"']*",
+    re.IGNORECASE)
+ACCESS_LOGGERS = ("uvicorn.access", "gunicorn.access", "uvicorn.error", "gunicorn.error")
+
+
+def redact(text: str) -> str:
+    if not isinstance(text, str) or "/" not in text and "=" not in text:
+        return text
+    return _SECRET_QUERY.sub(r"\1" + REDACTED, _SECRET_PATH.sub(r"\1" + REDACTED, text))
+
+
+class SecretPathFilter(logging.Filter):
+    """Never drops a record; only rewrites its message and string arguments."""
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        try:
+            if isinstance(record.msg, str):
+                record.msg = redact(record.msg)
+            if isinstance(record.args, tuple):
+                record.args = tuple(redact(a) if isinstance(a, str) else a
+                                    for a in record.args)
+            elif isinstance(record.args, dict):
+                record.args = {k: redact(v) if isinstance(v, str) else v
+                               for k, v in record.args.items()}
+        except Exception:  # noqa: BLE001 — logging must never fail a request
+            pass
+        return True
+
+
+_FILTER = SecretPathFilter()
+
+
+def install() -> None:
+    """Idempotent: attach the filter to every access/error logger."""
+    for name in ACCESS_LOGGERS:
+        lg = logging.getLogger(name)
+        if _FILTER not in lg.filters:
+            lg.addFilter(_FILTER)
