@@ -817,6 +817,10 @@ class Engine:
         if obs.state == DONE:
             # the stalled attempt finished after all: drop the resend, verify its result
             self._set(task, redispatch=0, last_reason="late_result_after_stall")
+            if task["state"] != tc.WORKING:
