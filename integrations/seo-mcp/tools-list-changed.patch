+# ── tool catalog change notification ─────────────────────────────────────────
+# The catalog changes when this backend is deployed with new tools. MCP clients cache it, so
+# the server advertises `tools.listChanged` and, on a connector's server stream, sends
+# `notifications/tools/list_changed` when the catalog this token last listed differs from the
+# one being served now. The record is a small file in the container's temp dir so every
+# gunicorn worker sees it (a rebuilt/recreated container starts empty = changed).
+LIST_CHANGED_NOTIFICATION = {"jsonrpc": "2.0", "method": "notifications/tools/list_changed"}
+
+
+def _listed_path() -> str:
+    return os.getenv("MCP_LISTED_CATALOG_FILE", "/tmp/owner-os-mcp-listed-catalog.json")
+
+
+def _read_listed() -> dict:
+    """Never follows a symlink at the record path; anything odd reads as empty (= changed)."""
+    import json as _json
+    try:
+        fd = os.open(_listed_path(), os.O_RDONLY | os.O_NOFOLLOW)
+    except OSError:
+        return {}
+    try:
+        with os.fdopen(fd, encoding="utf-8") as fh:
+            d = _json.load(fh)
+        return d if isinstance(d, dict) else {}
+    except (OSError, ValueError):
+        return {}
+
+
+def _mark_listed(token) -> None:
+    """Record this token's catalog atomically and safely in a shared temp dir:
+    flock on a no-follow lock file serialises workers; the new record is written to a
+    mkstemp file (O_EXCL, 0600, random name) and renamed over the path (a rename replaces
+    a planted symlink instead of following it). Any refusal only costs one extra
+    list_changed notification."""
+    import fcntl
+    import json as _json
+    import tempfile
+    path = _listed_path()
+    try:
+        lock = os.open(path + ".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+    except OSError:
+        return
+    try:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        d = _read_listed()
+        d[str(getattr(token, "id", None))] = tool_catalog_fingerprint()
+        fd, tmp = tempfile.mkstemp(prefix=".owner-os-mcp-listed.", dir=os.path.dirname(path))
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as fh:
+                _json.dump(d, fh)
+            os.replace(tmp, path)
+        except OSError:
+            try:
+                os.unlink(tmp)
+            except OSError:
+                pass
+    except OSError:
+        pass
+    finally:
+        os.close(lock)
+
+
+def tool_catalog_fingerprint() -> str:
+    import json as _json
+    return hashlib.sha256(_json.dumps(tool_schemas(), sort_keys=True, default=str)
+                          .encode()).hexdigest()[:16]
+
+
+def catalog_changed_for(token) -> bool:
+    return _read_listed().get(str(getattr(token, "id", None))) != tool_catalog_fingerprint()
+
+
 # ══════════════════════════════ JSON-RPC (MCP protocol) ══════════════════════════════
 SUPPORTED_PROTOCOLS = {"2025-06-18", "2025-03-26", "2024-11-05"}
 
@@ -993,7 +1065,7 @@ async def dispatch_rpc(db: AsyncSession, token: McpToken, method: str, params: d
         want = params.get("protocolVersion")
         proto = want if want in SUPPORTED_PROTOCOLS else MCP_PROTOCOL_VERSION
         return {"protocolVersion": proto,
-                "capabilities": {"tools": {"listChanged": False}, "resources": {"subscribe": False}},
+                "capabilities": {"tools": {"listChanged": True}, "resources": {"subscribe": False}},
