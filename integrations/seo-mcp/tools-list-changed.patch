+"""Tool catalog change notification (MCP tools.listChanged)."""
+import asyncio
+import json
+import os
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from services import mcp_server as mcp
+
+
+@pytest.fixture(autouse=True)
+def _fresh(monkeypatch, tmp_path):
+    monkeypatch.setenv("MCP_LISTED_CATALOG_FILE", str(tmp_path / "listed.json"))
+
+
+@pytest.mark.asyncio
+async def test_initialize_advertises_list_changed():
+    out = await mcp.dispatch_rpc(MagicMock(), SimpleNamespace(id=3, scopes=["read"]),
+                                 "initialize", {})
+    assert out["capabilities"]["tools"]["listChanged"] is True
+
+
+def test_fingerprint_is_stable_and_tracks_the_catalog(monkeypatch):
+    a = mcp.tool_catalog_fingerprint()
+    assert a == mcp.tool_catalog_fingerprint()
+    monkeypatch.setitem(mcp.TOOLS, "zz_new_tool", {"scope": "read", "fn": None, "desc": "x"})
+    assert mcp.tool_catalog_fingerprint() != a
+
+
+@pytest.mark.asyncio
+async def test_tools_list_marks_the_token_current_until_the_catalog_changes(monkeypatch):
+    tok = SimpleNamespace(id=3, scopes=["read"])
+    assert mcp.catalog_changed_for(tok)
+    await mcp.dispatch_rpc(MagicMock(), tok, "tools/list", {})
+    assert not mcp.catalog_changed_for(tok)
+    assert mcp.catalog_changed_for(SimpleNamespace(id=4))           # per token
+    monkeypatch.setitem(mcp.TOOLS, "zz_new_tool", {"scope": "read", "fn": None, "desc": "x"})
+    assert mcp.catalog_changed_for(tok)
+
+
+def _stream(monkeypatch, tok):
+    import routes_mcp as r
+    monkeypatch.setattr(r, "_enforce_https", lambda req: None)
+    monkeypatch.setattr(r.mcp, "verify_token", AsyncMock(return_value=tok))
+    db = MagicMock()
+    res = MagicMock()
+    res.scalar.return_value = 0
+    db.execute = AsyncMock(return_value=res)
+    req = MagicMock()
+    req.is_disconnected = AsyncMock(return_value=True)
+    resp = asyncio.run(r.connector_sse("ptok", req, db))
+
+    async def first(n):
+        out = []
+        async for chunk in resp.body_iterator:
+            out.append(chunk if isinstance(chunk, str) else chunk.decode())
+            if len(out) >= n:
+                break
+        return out
+    return asyncio.run(first(2))
+
+
+def test_server_stream_announces_a_changed_catalog_as_json_rpc(monkeypatch):
+    chunks = _stream(monkeypatch, SimpleNamespace(id=3, scopes=["read"]))
+    assert chunks[0].startswith("event: ready")
+    assert chunks[1].startswith("event: message\ndata: ")
+    msg = json.loads(chunks[1].split("data: ", 1)[1])
+    assert msg == {"jsonrpc": "2.0", "method": "notifications/tools/list_changed"}
+
+
+@pytest.mark.asyncio
+async def test_server_stream_is_quiet_when_the_token_has_the_current_catalog(monkeypatch):
+    tok = SimpleNamespace(id=3, scopes=["read"])
+    await mcp.dispatch_rpc(MagicMock(), tok, "tools/list", {})
+    chunks = await asyncio.to_thread(_stream, monkeypatch, tok)
+    assert not any("list_changed" in c for c in chunks)
+
+
+@pytest.mark.asyncio
+async def test_the_record_is_shared_across_workers(tmp_path, monkeypatch):
+    """gunicorn runs several workers: what one worker listed, another must see."""
+    tok = SimpleNamespace(id=3, scopes=["read"])
+    await mcp.dispatch_rpc(MagicMock(), tok, "tools/list", {})
+    import importlib.util
+    spec = importlib.util.spec_from_file_location("mcp_worker2", mcp.__file__)
+    other = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(other)                      # a second, independent module copy
+    assert not other.catalog_changed_for(tok)
+
+
+def test_unreadable_record_means_changed(tmp_path, monkeypatch):
+    (tmp_path / "listed.json").write_text("not json")
+    assert mcp.catalog_changed_for(SimpleNamespace(id=3))
+
+
+# ── temp-file hardening (shared /tmp, possibly root) ───────────────────────────
+
+@pytest.mark.asyncio
+async def test_a_planted_symlink_at_the_record_path_is_replaced_not_followed(tmp_path):
+    victim = tmp_path / "victim"
+    planted = json.dumps({"3": mcp.tool_catalog_fingerprint()})   # would say "up to date"
+    victim.write_text(planted)
+    rec = tmp_path / "listed.json"
+    rec.symlink_to(victim)
+    assert mcp.catalog_changed_for(SimpleNamespace(id=3))          # read did not follow
+    await mcp.dispatch_rpc(MagicMock(), SimpleNamespace(id=4, scopes=["read"]), "tools/list", {})
+    assert victim.read_text() == planted                           # write did not follow
+    assert not rec.is_symlink() and not mcp.catalog_changed_for(SimpleNamespace(id=4))
+    assert mcp.catalog_changed_for(SimpleNamespace(id=3))          # planted entry not imported
+
+
+@pytest.mark.asyncio
+async def test_a_planted_symlink_lock_file_is_refused(tmp_path):
+    victim = tmp_path / "victim"
+    victim.write_text("precious")
+    (tmp_path / "listed.json.lock").symlink_to(victim)
+    await mcp.dispatch_rpc(MagicMock(), SimpleNamespace(id=3, scopes=["read"]), "tools/list", {})
+    assert victim.read_text() == "precious"
+    assert mcp.catalog_changed_for(SimpleNamespace(id=3))          # skipped, not unsafe
+
+
+@pytest.mark.asyncio
+async def test_record_files_are_private_and_no_temp_files_leak(tmp_path):
+    await mcp.dispatch_rpc(MagicMock(), SimpleNamespace(id=3, scopes=["read"]), "tools/list", {})
+    import stat
+    assert stat.S_IMODE((tmp_path / "listed.json").stat().st_mode) == 0o600
+    assert stat.S_IMODE((tmp_path / "listed.json.lock").stat().st_mode) == 0o600
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["listed.json", "listed.json.lock"]
+
+
+def test_concurrent_workers_lose_no_token(tmp_path):
+    """Separate processes (like gunicorn workers) marking different tokens at once."""
+    import subprocess
+    import sys
+    import time
+    start = time.time() + 1.0
+    code = ("import sys,time,os;sys.path.insert(0,os.getcwd());"
+            "from types import SimpleNamespace;from services import mcp_server as m;"
+            f"t=float({start!r})\n"
+            "while time.time()<t: time.sleep(0.001)\n"
+            "[m._mark_listed(SimpleNamespace(id=int(sys.argv[1])*100+i)) for i in range(20)]")
+    env = {**os.environ, "MCP_LISTED_CATALOG_FILE": str(tmp_path / "listed.json")}
+    procs = [subprocess.Popen([sys.executable, "-c", code, str(w)], env=env)
+             for w in range(4)]
+    assert all(p.wait(60) == 0 for p in procs)
+    rec = json.loads((tmp_path / "listed.json").read_text())
+    assert len(rec) == 80
