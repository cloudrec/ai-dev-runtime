+async def grant_get(path: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
+    """Owner delegation grants (runtime /api/v1/grants*). Request/list/revoke only — the
+    runtime has no approval route; the owner approves out of band."""
+    if not configured():
+        raise RuntimeError("runtime not configured (RUNTIME_URL unset)")
+    async with httpx.AsyncClient(timeout=TIMEOUT) as client:
+        r = await client.get(f"{RUNTIME_URL}/grants{path}", params=params or {},
+                             headers=_headers())
+        return _agent_result(r)
+
+
+async def grant_post(path: str, payload: dict[str, Any]) -> dict[str, Any]:
+    if not configured():
+        raise RuntimeError("runtime not configured (RUNTIME_URL unset)")
+    async with httpx.AsyncClient(timeout=TIMEOUT) as client:
+        r = await client.post(f"{RUNTIME_URL}/grants{path}", json=payload, headers=_headers())
+        return _agent_result(r)
+
