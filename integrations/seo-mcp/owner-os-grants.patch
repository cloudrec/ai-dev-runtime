+# ── Owner delegation grants (runtime /api/v1/grants) ────────────────────────
+# ChatGPT may REQUEST a grant and list/revoke grants; only the owner can approve it, out of
+# band (host CLI `tools/owner_grant.py approve <id>` or the verified owner Telegram chat).
+# Once active, the existing agent_* tools work on the granted agents for THIS token only.
+async def _t_grant_request(db, p):
+    from services import runtime_client
+    body = {k: p.get(k) for k in ("project", "actions", "targets", "create", "ttl_secs")
+            if p.get(k) is not None}
+    return await runtime_client.grant_post("/request", body)
+
+
+async def _t_grant_list(db, p):
+    from services import runtime_client
+    return await runtime_client.grant_get("")
+
+
+async def _t_grant_revoke(db, p):
+    from services import runtime_client
+    gid = (p.get("grant_id") or "").strip()
+    if not gid:
+        return {"error": "grant_id required"}
+    return await runtime_client.grant_post(f"/{gid}/revoke", {})
+
+
